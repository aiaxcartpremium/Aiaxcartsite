# ============================================
# .GITIGNORE
# Files and folders that should NOT be committed
# ============================================

# Sensitive configuration files
config.private.js
.env
.env.local
.env.production

# API Keys and secrets
secrets.json
credentials.json

# Node modules
node_modules/
npm-debug.log
yarn-error.log

# Build outputs
dist/
build/
.next/
out/

# Logs
*.log
logs/

# Operating System files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Temporary files
tmp/
temp/
*.tmp

# Database files
*.sqlite
*.db
